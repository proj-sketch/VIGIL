# ─────────────────────────────────────────────────────────────────────────────
# Emergency Response Voice Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Get this from: Supabase Dashboard → Settings → Database → Connection String
# Use the "Session mode" pooler URL for long-lived async connections (asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_MINIMUM_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480         # 8 hours for operators/responders
JWT_SESSION_TOKEN_EXPIRE_MINUTES=240        # 4 hours for citizens
JWT_WS_TICKET_EXPIRE_SECONDS=60             # 60 seconds — one-time WS upgrade

# ── AssemblyAI ────────────────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=ce286274357c43a797cd015fb37edcb4

# ── Gemini (Structured Analysis Provider) ────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash                # flash for low latency in MVP

# ── Geocoding (Nominatim) ─────────────────────────────────────────────────────
NOMINATIM_USER_AGENT=EmergencyResponseVoiceAgent/1.0 (hackathon@example.com)
NOMINATIM_TIMEOUT_SECONDS=5
NOMINATIM_CACHE_TTL_SECONDS=3600
NOMINATIM_CACHE_MAX_SIZE=500

# ── Agent / tool configuration ────────────────────────────────────────────────
TOOL_TIMEOUT_SECONDS=10
STRUCTURED_ANALYSIS_TIMEOUT_SECONDS=8
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
MAX_CLARIFICATION_TURNS=6

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_VOICE_SESSIONS=5/minute
RATE_LIMIT_INCIDENTS=10/minute
RATE_LIMIT_LOCATION=30/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=120/minute

# ── Session reconnect window ──────────────────────────────────────────────────
VOICE_SESSION_RECONNECT_WINDOW_SECONDS=30
